msgid "Automatisch detecteren"
msgstr "Detect automatically"

#: Source/RdcmX.UI.Gateways.dfm
msgid "Altijd, behalve voor lokale adressen"
msgstr "Always, except for local addresses"

#: Source/RdcmX.UI.Gateways.dfm
msgid "Dezelfde als voor de sessie"
msgstr "Same as for the session"

#: Source/RdcmX.UI.Gateways.dfm
