#: Source/RdcmX.UI.CredentialPrompt.dfm Source/RdcmX.UI.Properties.dfm
msgid "Aanmelden"
msgstr "Logon"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Verbinden met"
msgstr "Connect to"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Gebruikersnaam voor deze server; mag ook als DOMEIN\\gebruiker of gebruiker@domein."
msgstr "User name for this server; DOMAIN\\user or user@domain is also allowed."

#: Source/RdcmX.UI.CredentialPrompt.dfm Source/RdcmX.UI.Gateways.dfm Source/RdcmX.UI.Profiles.dfm Source/RdcmX.UI.Properties.dfm
msgid "Gebruikersnaam"
msgstr "User name"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Domein van de gebruiker; leeg bij een lokaal account op de server."
msgstr "Domain of the user; empty for a local account on the server."

#: Source/RdcmX.UI.CredentialPrompt.dfm Source/RdcmX.UI.Gateways.dfm Source/RdcmX.UI.Profiles.dfm Source/RdcmX.UI.Properties.dfm
msgid "Domein"
msgstr "Domain"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Wachtwoord voor deze verbinding. Het wordt na gebruik uit het geheugen gewist."
msgstr "Password for this connection. It is wiped from memory after use."

#: Source/RdcmX.UI.CredentialPrompt.dfm Source/RdcmX.UI.Gateways.dfm
msgid "Wachtwoord"
msgstr "Password"

#: Source/RdcmX.UI.CredentialPrompt.dfm Source/RdcmX.UI.CredentialPrompt.pas
msgid "Het wachtwoord wordt niet opgeslagen."
msgstr "The password is not stored."

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Het wachtwoord versleuteld in de wachtwoordkluis bewaren, zodat het de volgende keer niet gevraagd wordt."
msgstr "Keep the password encrypted in the password vault, so it is not asked next time."

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Wachtwoord onthouden"
msgstr "Remember password"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Gebruikersnaam en domein opslaan bij deze server in het bestand (zoals op het tabblad Aanmelden), zodat ze de volgende keer ingevuld zijn. Het wachtwoord valt hier niet onder."
msgstr "Store the user name and domain with this server in the file (as on the Logon tab), so they are filled in next time. This does not include the password."

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Gebruikersnaam en domein onthouden"
msgstr "Remember user name and domain"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Verbinden met deze aanmeldgegevens."
msgstr "Connect with these credentials."

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Verbinden"
msgstr "Connect"

#: Source/RdcmX.UI.CredentialPrompt.dfm
msgid "Niet verbinden."
msgstr "Do not connect."

