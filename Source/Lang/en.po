msgid "Smartcard"
msgstr "Smart card"

#: Source/RdcmX.UI.Gateways.dfm
msgid "Wachtwoord (NTLM)"
msgstr "Password (NTLM)"

#: Source/RdcmX.UI.Gateways.dfm Source/RdcmX.UI.Properties.pas
msgid "Automatisch"
msgstr "Automatic"

#: Source/RdcmX.UI.Gateways.dfm
